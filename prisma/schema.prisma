generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  firebaseUid   String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  dob           String?
  isPremium        Boolean   @default(false)
  isGuest          Boolean   @default(false)
  dailyUsage       Int       @default(0)
  usageDate        String?
  selectedResumeId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  selectedResume Resume?   @relation("SelectedResume", fields: [selectedResumeId], references: [id])
  accounts       Account[]
  sessions       Session[]
  resumes        Resume[]
  jobDescriptions JobDescription[]
  analyses       Analysis[]
  interviewPreps InterviewPrep[]
  mockInterviews MockInterview[]
  weakAreas      WeakArea[]
  subscription   Subscription?
  usageLogs             UsageLog[]
  bookmarks             Bookmark[]
  jobSessions           JobRecommendationSession[]
  readiness             UserReadiness?
  performanceSnapshots  WeakAreaSnapshot[]
  roadmaps              CareerRoadmap[]
  dailyChallenges       DailyChallenge[]
  targetCompanies       TargetCompany[]
  weeklyReports         WeeklyCareerReport[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id                String   @id @default(uuid())
  userId            String
  title             String   @default("Untitled Resume")
  content           String
  uploadType        String   @default("paste")
  fileName          String?
  parsedText        String?
  resumeLabel       String?  // user-friendly label like "Backend Resume"
  resumeType        String?  // backend, fullstack, ml, general, startup, custom
  timesUsed         Int      @default(0)
  averageMatchScore Float    @default(0)
  bestMatchScore    Float    @default(0)
  totalAnalyses     Int      @default(0)
  lastUsedAt        DateTime?
  performanceMetadata String? // JSON: aggregated stats
  isArchived        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    Analysis[]
  selectedBy  User?                      @relation("SelectedResume")
  performanceSnapshots ResumePerformanceSnapshot[]
}

model ResumePerformanceSnapshot {
  id                   String   @id @default(uuid())
  resumeId             String
  userId               String
  atsScore             Int      @default(0)
  matchScore           Int      @default(0)
  resumeQuality        Int      @default(0)
  technicalStrength    Int      @default(0)
  behavioralStrength   Int      @default(0)
  jobRole              String?
  analysisId           String?
  createdAt            DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}

model JobDescription {
  id        String   @id @default(uuid())
  userId    String
  content   String
  category  String?
  createdAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses Analysis[]
}

model Analysis {
  id               String   @id @default(uuid())
  userId           String
  resumeId         String
  jobDescriptionId String
  matchScore       Int
  strengths        String
  missingKeywords  String
  weakAreas        String
  resumeImprovements String
  summary          String
  questions        String
  answerGuidance   String
  jobCategory      String?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  interviewPreps InterviewPrep[]
}

model InterviewPrep {
  id         String   @id @default(uuid())
  userId     String
  analysisId String
  status     String   @default("active")
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model MockInterview {
  id             String    @id @default(uuid())
  userId         String
  difficulty     String    @default("standard")
  questionTypes  String    @default("mixed")
  questionCount  Int       @default(5)
  currentIndex   Int       @default(0)
  questions      String
  scores         String?
  feedback       String?
  status         String    @default("in_progress")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers  MockAnswer[]
}

model MockAnswer {
  id              String   @id @default(uuid())
  mockInterviewId String
  question        String
  userAnswer      String
  feedback        String?
  scores          String?
  createdAt       DateTime @default(now())

  mockInterview MockInterview @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
}

model WeakArea {
  id        String   @id @default(uuid())
  userId    String
  area      String
  category  String
  count     Int      @default(1)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                          String    @id @default(uuid())
  userId                      String    @unique
  lemonSqueezySubscriptionId  String?
  lemonSqueezyCustomerId      String?
  status                      String    @default("inactive")
  planId                      String?
  currentPeriodEnd            DateTime?
  canceledAt                  DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobRecommendationSession {
  id            String   @id @default(uuid())
  userId        String
  resumeId      String
  cacheKey      String
  extractedData String
  generatedAt   DateTime @default(now())
  refreshedAt   DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs RecommendedJob[]

  @@unique([userId, cacheKey])
}

model RecommendedJob {
  id               String   @id @default(uuid())
  sessionId        String
  jobId            String
  title            String
  employer         String
  location         String
  remote           Boolean  @default(false)
  salary           String?
  employmentType   String?
  description      String?
  shortDescription String?
  applyUrl         String?
  source           String   @default("jsearch")
  datePosted       String?
  score            Float    @default(0)
  rawData          String?

  session JobRecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jobId])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  question   String
  guidance   String?
  analysisId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, question])
}

model UserReadiness {
  id                         String   @id @default(uuid())
  userId                     String   @unique
  overallScore               Int      @default(0)

  resumeQualityScore         Int      @default(0)
  atsScore                   Int      @default(0)
  interviewReadinessScore    Int      @default(0)
  behavioralConfidenceScore  Int      @default(0)
  technicalReadinessScore    Int      @default(0)
  marketCompetitivenessScore Int      @default(0)

  level                      String   @default("beginner") // beginner, developing, competitive, interview-ready
  strengths                  String   @default("[]")  // JSON array of strings
  weaknesses                 String   @default("[]")  // JSON array of strings

  lastCalculatedAt           DateTime @default(now())
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeakAreaSnapshot {
  id                    String   @id @default(uuid())
  userId                String

  communicationScore    Int      @default(0)
  confidenceScore       Int      @default(0)
  behavioralScore       Int      @default(0)
  technicalScore        Int      @default(0)
  problemSolvingScore   Int      @default(0)
  structureScore        Int      @default(0)
  clarityScore          Int      @default(0)
  relevanceScore        Int      @default(0)
  leadershipScore       Int      @default(0)
  systemThinkingScore   Int      @default(0)

  overallInterviewScore Int      @default(0)
  source                String   @default("mock_interview")
  sessionId             String?

  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerRoadmap {
  id                String   @id @default(uuid())
  userId            String
  title             String
  goalRole          String?
  experienceLevel   String?
  currentReadiness  Int      @default(0)
  targetReadiness   Int      @default(80)
  status            String   @default("active")
  generatedReasoning String?
  startDate         DateTime @default(now())
  endDate           DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks RoadmapTask[]
}

model RoadmapTask {
  id                String    @id @default(uuid())
  roadmapId         String
  dayNumber         Int
  weekNumber        Int
  title             String
  description       String
  category          String    @default("resume")
  priority          String    @default("medium")
  estimatedMinutes  Int       @default(15)
  completed         Boolean   @default(false)
  completionDate    DateTime?
  improvementImpact String?
  premium           Boolean   @default(false)
  createdAt         DateTime  @default(now())

  roadmap CareerRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
}

model DailyChallenge {
  id                   String    @id @default(uuid())
  userId               String
  question             String
  questionType         String    @default("behavioral")
  difficulty           String    @default("medium")
  personalizationReason String?
  generatedDate        String    // ISO date string — one challenge per day per user
  completed            Boolean   @default(false)
  completedAt          DateTime?
  answerText           String?
  score                Int?
  feedback             String?   // JSON { strengths, improvements, scores }
  createdAt            DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, generatedDate])
}

model TargetCompany {
  id              String   @id @default(uuid())
  userId          String
  companyName     String
  companyType     String   @default("product") // faang, product, startup, service, backend
  targetRole      String?
  experienceLevel String?
  priority        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyName])
}

model WeeklyCareerReport {
  id                       String   @id @default(uuid())
  userId                   String
  weekStart                String   // ISO date string: "2026-05-26"
  weekEnd                  String   // ISO date string: "2026-06-01"

  readinessBefore          Int      @default(0)
  readinessAfter           Int      @default(0)

  interviewConfidenceDelta Int      @default(0)
  resumeScoreDelta         Int      @default(0)
  atsScoreDelta            Int      @default(0)

  mockCount                Int      @default(0)
  challengeCount           Int      @default(0)
  jobApplicationsCount     Int      @default(0)
  resumeTailorsCount       Int      @default(0)

  wins                     String   @default("[]")   // JSON string[]
  focusAreas               String   @default("[]")   // JSON string[]
  recommendations          String   @default("[]")   // JSON string[]
  premiumInsights          String?                    // JSON (premium-only)

  createdAt                DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

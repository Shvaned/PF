generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  firebaseUid   String?   @unique
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  dob           String?
  isPremium        Boolean   @default(false)
  isGuest          Boolean   @default(false)
  dailyUsage       Int       @default(0)
  usageDate        String?
  selectedResumeId String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  selectedResume Resume?   @relation("SelectedResume", fields: [selectedResumeId], references: [id])
  accounts       Account[]
  sessions       Session[]
  resumes        Resume[]
  jobDescriptions JobDescription[]
  analyses       Analysis[]
  interviewPreps InterviewPrep[]
  mockInterviews MockInterview[]
  weakAreas      WeakArea[]
  subscription   Subscription?
  usageLogs             UsageLog[]
  bookmarks             Bookmark[]
  jobSessions           JobRecommendationSession[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id         String   @id @default(uuid())
  userId     String
  title      String   @default("Untitled Resume")
  content    String
  uploadType String   @default("paste")
  fileName   String?
  parsedText String?
  createdAt  DateTime @default(now())

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses    Analysis[]
  selectedBy  User?      @relation("SelectedResume")
}

model JobDescription {
  id        String   @id @default(uuid())
  userId    String
  content   String
  category  String?
  createdAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses Analysis[]
}

model Analysis {
  id               String   @id @default(uuid())
  userId           String
  resumeId         String
  jobDescriptionId String
  matchScore       Int
  strengths        String
  missingKeywords  String
  weakAreas        String
  resumeImprovements String
  summary          String
  questions        String
  answerGuidance   String
  jobCategory      String?
  createdAt        DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume         @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobDescription JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  interviewPreps InterviewPrep[]
}

model InterviewPrep {
  id         String   @id @default(uuid())
  userId     String
  analysisId String
  status     String   @default("active")
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

model MockInterview {
  id             String    @id @default(uuid())
  userId         String
  difficulty     String    @default("standard")
  questionTypes  String    @default("mixed")
  questionCount  Int       @default(5)
  currentIndex   Int       @default(0)
  questions      String
  scores         String?
  feedback       String?
  status         String    @default("in_progress")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers  MockAnswer[]
}

model MockAnswer {
  id              String   @id @default(uuid())
  mockInterviewId String
  question        String
  userAnswer      String
  feedback        String?
  scores          String?
  createdAt       DateTime @default(now())

  mockInterview MockInterview @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
}

model WeakArea {
  id        String   @id @default(uuid())
  userId    String
  area      String
  category  String
  count     Int      @default(1)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                          String    @id @default(uuid())
  userId                      String    @unique
  lemonSqueezySubscriptionId  String?
  lemonSqueezyCustomerId      String?
  status                      String    @default("inactive")
  planId                      String?
  currentPeriodEnd            DateTime?
  canceledAt                  DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobRecommendationSession {
  id            String   @id @default(uuid())
  userId        String
  resumeId      String
  cacheKey      String
  extractedData String
  generatedAt   DateTime @default(now())
  refreshedAt   DateTime @default(now())

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs RecommendedJob[]

  @@unique([userId, cacheKey])
}

model RecommendedJob {
  id               String   @id @default(uuid())
  sessionId        String
  jobId            String
  title            String
  employer         String
  location         String
  remote           Boolean  @default(false)
  salary           String?
  employmentType   String?
  description      String?
  shortDescription String?
  applyUrl         String?
  source           String   @default("jsearch")
  datePosted       String?
  score            Float    @default(0)
  rawData          String?

  session JobRecommendationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jobId])
}

model Bookmark {
  id         String   @id @default(uuid())
  userId     String
  question   String
  guidance   String?
  analysisId String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, question])
}
